# Copiá este archivo a .env y completá los valores reales.
# .env nunca se commitea (ver .gitignore).

# Gemini Vision — extrae los datos del evento desde el flyer (gratis, aistudio.google.com/apikey)
GEMINI_API_KEY=

# Claude Vision — fallback si Gemini falla o se queda sin cuota (opcional,
# pero recomendado; sin esto una falla de Gemini se pierde hasta el próximo run)
ANTHROPIC_API_KEY=
# Tope de seguridad para no generar costos al ampliar el descubrimiento.
MAX_CLAUDE_CALLS_PER_RUN=1

# SerpAPI — busca flyers en Google Images (serpapi.com/dashboard)
SERPAPI_KEY=

# Serper — respaldo automático para Google Images (serper.dev)
SERPER_API_KEY=

# HikerAPI — descubrimiento por hashtag/cuenta en Instagram: imagen sin
# recortar, caption completo, fecha real de publicación del post
# (hikerapi.com). REQUERIDA por src/hiker_pipeline.py (el pipeline de
# producción) — sin esto el pipeline aborta. Pago por request (~$0.0006c/u).
HIKERAPI_KEY=

# Cuenta de servicio de Google con acceso de editor a la Sheet de Eventos.
# IMPORTANTE: tiene que ir en UNA SOLA LÍNEA (Google Cloud Console lo descarga
# formateado en varias líneas — si lo pegás así tal cual, se corta y no funciona).
# Para colapsarlo: python3 -c "import json;print(json.dumps(json.load(open('cred.json'))))"
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID de la Google Sheet que lee hayminga.org (está en la URL de la sheet)
GOOGLE_SPREADSHEET_ID=

# Bot de Telegram para el resumen semanal (src/enviar_resumen_telegram.py).
# Creá el bot con @BotFather, y el chat_id mandándole un mensaje y
# consultando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
