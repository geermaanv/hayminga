# Copiá este archivo a .env y completá los valores reales.
# .env nunca se commitea (ver .gitignore).

# Claude Vision — extrae los datos del evento desde el flyer
ANTHROPIC_API_KEY=

# SerpAPI — busca flyers en Google Images (serpapi.com/dashboard)
SERPAPI_KEY=

# Cuenta de servicio de Google con acceso de editor a la Sheet de Eventos.
# IMPORTANTE: tiene que ir en UNA SOLA LÍNEA (Google Cloud Console lo descarga
# formateado en varias líneas — si lo pegás así tal cual, se corta y no funciona).
# Para colapsarlo: python3 -c "import json;print(json.dumps(json.load(open('cred.json'))))"
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID de la Google Sheet que lee hayminga.org (está en la URL de la sheet)
GOOGLE_SPREADSHEET_ID=
